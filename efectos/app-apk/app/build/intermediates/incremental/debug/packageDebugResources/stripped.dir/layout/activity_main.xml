<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- ── Fixed header ───────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:gravity="center"/>

        <View
            android:id="@+id/viewStatusLed"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:background="@android:drawable/presence_offline"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready — connect headphones and press START"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvGainLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GAIN: +12 dB"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

        <SeekBar
            android:id="@+id/seekGain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:max="100"
            android:progress="60"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- ── Scrollable pedalboard ───────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="8dp">

            <!-- Row 1: Reverb | Delay -->
            <LinearLayout
                android:id="@+id/pedalRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnReverb"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="REVERB&#10;○ OFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="@color/pedal_reverb_off"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnDelay"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="DELAY&#10;○ OFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="@color/pedal_delay_off"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Reverb controls (collapsible) -->
            <LinearLayout
                android:id="@+id/layoutReverbControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="#1AFFFFFF"
                android:padding="12dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="── REVERB ──"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvReverbRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ROOM: 0.72"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"/>
                <SeekBar
                    android:id="@+id/seekReverbRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:max="100"
                    android:progress="65"/>

                <TextView
                    android:id="@+id/tvReverbMix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MIX: 28%"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>
                <SeekBar
                    android:id="@+id/seekReverbMix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:max="100"
                    android:progress="47"/>
            </LinearLayout>

            <!-- Delay controls (collapsible) -->
            <LinearLayout
                android:id="@+id/layoutDelayControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="#1AFFFFFF"
                android:padding="12dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="── DELAY ──"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvDelayTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TIME: 375 ms"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"/>
                <SeekBar
                    android:id="@+id/seekDelayTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:max="100"
                    android:progress="46"/>

                <TextView
                    android:id="@+id/tvDelayFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FEEDBACK: 45%"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>
                <SeekBar
                    android:id="@+id/seekDelayFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:max="100"
                    android:progress="50"/>

                <TextView
                    android:id="@+id/tvDelayWet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MIX: 35%"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>
                <SeekBar
                    android:id="@+id/seekDelayWet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:max="100"
                    android:progress="50"/>
            </LinearLayout>

            <!-- Row 2: Overdrive | Wah-Wah -->
            <LinearLayout
                android:id="@+id/pedalRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnOverdrive"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="OVERDRIVE&#10;○ OFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="@color/pedal_overdrive_off"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnWah"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="WAH-WAH&#10;○ OFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="@color/pedal_wah_off"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Overdrive controls (collapsible) -->
            <LinearLayout
                android:id="@+id/layoutOverdriveControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="#1AFFFFFF"
                android:padding="12dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="── OVERDRIVE ──"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvOdDrive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DRIVE: 4.5×"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"/>
                <SeekBar
                    android:id="@+id/seekOdDrive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:max="100"
                    android:progress="25"/>

                <TextView
                    android:id="@+id/tvOdTone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TONE: 50%"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>
                <SeekBar
                    android:id="@+id/seekOdTone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:max="100"
                    android:progress="50"/>
            </LinearLayout>

            <!-- Wah controls (collapsible) -->
            <LinearLayout
                android:id="@+id/layoutWahControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="#1AFFFFFF"
                android:padding="12dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="── WAH-WAH ──"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvWahSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SPEED: 2.5 Hz"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"/>
                <SeekBar
                    android:id="@+id/seekWahSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:max="100"
                    android:progress="47"/>

                <TextView
                    android:id="@+id/tvWahRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESONANCE: 2.5"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>
                <SeekBar
                    android:id="@+id/seekWahRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:max="100"
                    android:progress="30"/>
            </LinearLayout>

            <!-- Row 3: NAM (hidden — code intact, UI paused) -->
            <LinearLayout
                android:id="@+id/pedalRow3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnNam"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="2"
                    android:text="NAM&#10;○ OFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="@color/pedal_reverb_off"
                    android:enabled="false"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnLoadNam"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:text="LOAD&#10;.NAM"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="@color/btn_diagnostic"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNamInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="2dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- ── Fixed footer ───────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/tvDiagLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="peak=— miss=— xrun=—"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:text="START"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:backgroundTint="@color/btn_pedal"
            android:textColor="@color/text_primary"/>

        <Button
            android:id="@+id/btnDiagnostics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="DIAGNOSTICS"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:backgroundTint="@color/btn_diagnostic"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

</LinearLayout>
